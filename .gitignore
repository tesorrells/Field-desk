# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.dev.vars*
!.env.example

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
# Checkout-local execution profile and tool state; never publish them.
/.sites-runtime/
/.agents/
/.codex/
/outputs/
/work/

*.tsbuildinfo

# Local study data, backups and generated clean release
/.data/
/.release/
*.sqlite
*.sqlite-shm
*.sqlite-wal
/.local-storage-test-*/

# Optional peer transport credentials, also in custom data directories
peer-sync.json
peer-sync.json.tmp
peer-sync.lock

field-desk-identity.json

field-desk-identity.json.tmp

peer-inbox.sqlite
peer-inbox.sqlite-wal
peer-inbox.sqlite-shm

# Offline private identity recovery kits and retirement markers
*.field-desk-recovery
field-desk-retired.json
.field-desk-recovery-*/

field-desk-identity-binding.json
field-desk-identity-binding.json.tmp
